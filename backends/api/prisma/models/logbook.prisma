model Logbook {
  id Int @id @default(autoincrement())
  owner User @relation(fields: [ownerId], references: [id])
  ownerId Int
  name String @db.VarChar(64)
  logitems Logitem[]
  createdAt DateTime @default(now())
}

model Logitem {
  id Int @id @default(autoincrement())
  logbook Logbook @relation(fields: [logbookId], references: [id])
  logbookId Int
  title String @db.VarChar(64)
  body String? @db.VarChar(1024)
  crew Int?
  latitude Float?
  longitude Float?
  course Float?
  speedOverGround Float?
  speedThroughWater Float?
  windSpeed Float?
  barometer Float?
  createdAt DateTime @default(now())
}