HOST=localhost
ACME_EMAIL=your-email@example.com

DEVELOP=true
API_PORT=8000
JWT_SECRET=secret
ACCESS_TOKEN_EXPIRES=900 # 15 * 60 -> 15 minutes
REFRESH_TOKEN_EXPIRES=2592000 # 30 * 24 * 60 * 60 -> 30 days
RECOVERY_TOKEN_EXPIRES=600 # 10 * 60 -> 10 minutes
LOG_LEVEL=silly
MORGAN=dev

POSTGRES_VERSION=18
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
